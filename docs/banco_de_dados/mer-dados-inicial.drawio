        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    %% =========================================================\n    %% ClinicalStudyPB - Modelo Conceitual com Subgráficos (Organizado)\n    %% =========================================================\n\n    classDef e fill:#dbeafe,stroke:#1e40af,stroke-width:2px,color:#000\n    classDef r fill:#fef3c7,stroke:#b45309,stroke-width:2px,color:#000\n    classDef a fill:#ffffff,stroke:#6b7280,color:#000\n    classDef multi fill:#f3e8ff,stroke:#7c3aed,stroke-width:3px,stroke-dasharray: 4 4,color:#000\n    classDef isa fill:#fce7f3,stroke:#be185d,stroke-width:2px,color:#000\n\n    %% ---------- GRUPOS DE ENTIDADES E ATRIBUTOS ----------\n\n    subgraph S_USUARIO [USUÁRIO]\n        direction TB\n        USUARIO[\&quot;USUÁRIO (Supertipo)\&quot;]:::e\n        u1([\&quot;&lt;u&gt;id_usuario&lt;/u&gt;\&quot;]):::a\n        u2([\&quot;nome\&quot;]):::a\n        u3([\&quot;email (único)\&quot;]):::a\n        u4([\&quot;senha_hash\&quot;]):::a\n        u5([\&quot;ativo\&quot;]):::a\n        USUARIO --- u1\n        USUARIO --- u2\n        USUARIO --- u3\n        USUARIO --- u4\n        USUARIO --- u5\n    end\n\n    subgraph S_PARTICIPANTE [PARTICIPANTE]\n        direction TB\n        PARTICIPANTE[\&quot;PARTICIPANTE\&quot;]:::e\n        p1([\&quot;&lt;u&gt;id_participante&lt;/u&gt;\&quot;]):::a\n        p2([\&quot;data_inclusao\&quot;]):::a\n        p3([\&quot;situação\&quot;]):::a\n        p4([\&quot;data_retirada\&quot;]):::a\n        p5([\&quot;motivo_retirada\&quot;]):::a\n        PARTICIPANTE --- p1\n        PARTICIPANTE --- p2\n        PARTICIPANTE --- p3\n        PARTICIPANTE --- p4\n        PARTICIPANTE --- p5\n    end\n\n    subgraph S_ESTUDO [ESTUDO]\n        direction TB\n        ESTUDO[\&quot;ESTUDO\&quot;]:::e\n        s1([\&quot;&lt;u&gt;id_estudo&lt;/u&gt;\&quot;]):::a\n        s2([\&quot;título\&quot;]):::a\n        s3([\&quot;objetivo\&quot;]):::a\n        s4([\&quot;data_inicio\&quot;]):::a\n        s5([\&quot;data_fim\&quot;]):::a\n        s6([\&quot;limite_participantes\&quot;]):::a\n        s7([\&quot;estado\&quot;]):::a\n        ESTUDO --- s1\n        ESTUDO --- s2\n        ESTUDO --- s3\n        ESTUDO --- s4\n        ESTUDO --- s5\n        ESTUDO --- s6\n        ESTUDO --- s7\n    end\n\n    subgraph S_CRITERIO [CRITÉRIO]\n        direction TB\n        CRITERIO[\&quot;CRITÉRIO\&quot;]:::e\n        c1([\&quot;&lt;u&gt;id_criterio&lt;/u&gt;\&quot;]):::a\n        c2([\&quot;descrição\&quot;]):::a\n        c3([\&quot;tipo (inclusão/exclusão)\&quot;]):::a\n        CRITERIO --- c1\n        CRITERIO --- c2\n        CRITERIO --- c3\n    end\n\n    subgraph S_VISITA_PREVISTA [VISITA PREVISTA]\n        direction TB\n        VISITA_PREVISTA[\&quot;VISITA PREVISTA\&quot;]:::e\n        vp1([\&quot;&lt;u&gt;id_visita_prevista&lt;/u&gt;\&quot;]):::a\n        vp2([\&quot;nome\&quot;]):::a\n        vp3([\&quot;ordem\&quot;]):::a\n        vp4([\&quot;dias_apos_inclusao\&quot;]):::a\n        VISITA_PREVISTA --- vp1\n        VISITA_PREVISTA --- vp2\n        VISITA_PREVISTA --- vp3\n        VISITA_PREVISTA --- vp4\n    end\n\n    subgraph S_ATIVIDADE [ATIVIDADE PREVISTA]\n        direction TB\n        ATIVIDADE[\&quot;ATIVIDADE PREVISTA\&quot;]:::e\n        at1([\&quot;&lt;u&gt;id_atividade&lt;/u&gt;\&quot;]):::a\n        at2([\&quot;descrição\&quot;]):::a\n        at3([\&quot;tipo_resultado\&quot;]):::a\n        ATIVIDADE --- at1\n        ATIVIDADE --- at2\n        ATIVIDADE --- at3\n    end\n\n    subgraph S_CANDIDATO [CANDIDATO]\n        direction TB\n        CANDIDATO[\&quot;CANDIDATO\&quot;]:::e\n        ca1([\&quot;&lt;u&gt;id_candidato&lt;/u&gt;\&quot;]):::a\n        ca2([\&quot;nome\&quot;]):::a\n        ca3([\&quot;data_nascimento\&quot;]):::a\n        ca4([\&quot;contato [multivalorado]\&quot;]):::multi\n        ca5([\&quot;situação\&quot;]):::a\n        CANDIDATO --- ca1\n        CANDIDATO --- ca2\n        CANDIDATO --- ca3\n        CANDIDATO --- ca4\n        CANDIDATO --- ca5\n    end\n\n    subgraph S_CONSENTIMENTO [CONSENTIMENTO]\n        direction TB\n        CONSENTIMENTO[\&quot;CONSENTIMENTO\&quot;]:::e\n        co1([\&quot;&lt;u&gt;id_consentimento&lt;/u&gt;\&quot;]):::a\n        co2([\&quot;data_registro\&quot;]):::a\n        co3([\&quot;aceito\&quot;]):::a\n        co4([\&quot;versão_termo\&quot;]):::a\n        CONSENTIMENTO --- co1\n        CONSENTIMENTO --- co2\n        CONSENTIMENTO --- co3\n        CONSENTIMENTO --- co4\n    end\n\n    subgraph S_VISITA [VISITA]\n        direction TB\n        VISITA[\&quot;VISITA\&quot;]:::e\n        v1([\&quot;&lt;u&gt;id_visita&lt;/u&gt;\&quot;]):::a\n        v2([\&quot;data_hora\&quot;]):::a\n        v3([\&quot;situação\&quot;]):::a\n        v4([\&quot;observação\&quot;]):::a\n        VISITA --- v1\n        VISITA --- v2\n        VISITA --- v3\n        VISITA --- v4\n    end\n\n    subgraph S_SOLICITACAO [SOLICITAÇÃO]\n        direction TB\n        SOLICITACAO[\&quot;SOLICITAÇÃO\&quot;]:::e\n        so1([\&quot;&lt;u&gt;id_solicitacao&lt;/u&gt;\&quot;]):::a\n        so2([\&quot;tipo\&quot;]):::a\n        so3([\&quot;situação\&quot;]):::a\n        so4([\&quot;justificativa\&quot;]):::a\n        so5([\&quot;data_solicitacao\&quot;]):::a\n        so6([\&quot;data_decisao\&quot;]):::a\n        so7([\&quot;nova_data_sugerida\&quot;]):::a\n        SOLICITACAO --- so1\n        SOLICITACAO --- so2\n        SOLICITACAO --- so3\n        SOLICITACAO --- so4\n        SOLICITACAO --- so5\n        SOLICITACAO --- so6\n        SOLICITACAO --- so7\n    end\n\n    subgraph S_AUDITORIA [REGISTRO DE AUDITORIA]\n        direction TB\n        AUDITORIA[\&quot;REGISTRO DE AUDITORIA\&quot;]:::e\n        au1([\&quot;&lt;u&gt;id_log&lt;/u&gt;\&quot;]):::a\n        au2([\&quot;ação\&quot;]):::a\n        au3([\&quot;entidade_afetada\&quot;]):::a\n        au4([\&quot;data_hora\&quot;]):::a\n        au5([\&quot;detalhes\&quot;]):::a\n        AUDITORIA --- au1\n        AUDITORIA --- au2\n        AUDITORIA --- au3\n        AUDITORIA --- au4\n        AUDITORIA --- au5\n    end\n\n    %% ---------- OUTRAS ENTIDADES DA HERANÇA ----------\n    PESQUISADOR[\&quot;PESQUISADOR\&quot;]:::e\n    COORDENADOR[\&quot;COORDENADOR\&quot;]:::e\n    ADMINISTRADOR[\&quot;ADMINISTRADOR\&quot;]:::e\n    ISA{\&quot;É UM (ISA)\&quot;}:::isa\n\n    %% ---------- HIERARQUIA DE HERANÇA ----------\n    USUARIO --- ISA\n    ISA --- PESQUISADOR\n    ISA --- COORDENADOR\n    ISA --- ADMINISTRADOR\n    ISA --- PARTICIPANTE\n\n    %% ---------- RELACIONAMENTOS ----------\n    R_RESP{\&quot;É RESPONSÁVEL POR\&quot;}:::r\n    PESQUISADOR ---|\&quot;0..N\&quot;| R_RESP\n    R_RESP ---|\&quot;1..1 (Obrigatório)\&quot;| ESTUDO\n\n    R_ATUA{\&quot;ATUA EM\&quot;}:::r\n    COORDENADOR ---|\&quot;0..N\&quot;| R_ATUA\n    PESQUISADOR ---|\&quot;0..N\&quot;| R_ATUA\n    R_ATUA ---|\&quot;0..N\&quot;| ESTUDO\n    R_ATUA --- ra1([\&quot;papel_no_estudo\&quot;]):::a\n    R_ATUA --- ra2([\&quot;data_vinculo\&quot;]):::a\n    R_ATUA --- ra3([\&quot;ativo\&quot;]):::a\n\n    R_DEF{\&quot;DEFINE\&quot;}:::r\n    ESTUDO ---|\&quot;0..N\&quot;| R_DEF\n    R_DEF ---|\&quot;1..1 (Obrigatório)\&quot;| CRITERIO\n\n    R_PREVE{\&quot;PREVÊ\&quot;}:::r\n    ESTUDO ---|\&quot;0..N\&quot;| R_PREVE\n    R_PREVE ---|\&quot;1..1 (Obrigatório)\&quot;| VISITA_PREVISTA\n\n    R_COMPOE{\&quot;COMPÕE\&quot;}:::r\n    VISITA_PREVISTA ---|\&quot;0..N\&quot;| R_COMPOE\n    R_COMPOE ---|\&quot;1..1 (Obrigatório)\&quot;| ATIVIDADE\n\n    R_RECRUTA{\&quot;RECRUTA\&quot;}:::r\n    ESTUDO ---|\&quot;0..N\&quot;| R_RECRUTA\n    R_RECRUTA ---|\&quot;1..1 (Obrigatório)\&quot;| CANDIDATO\n\n    R_AVALIA{\&quot;AVALIA\&quot;}:::r\n    CANDIDATO ---|\&quot;0..N\&quot;| R_AVALIA\n    R_AVALIA ---|\&quot;0..N\&quot;| CRITERIO\n    R_AVALIA --- rv1([\&quot;atendido\&quot;]):::a\n    R_AVALIA --- rv2([\&quot;data_avaliacao\&quot;]):::a\n    R_AVALIA --- rv3([\&quot;observação\&quot;]):::a\n\n    R_CONSENTE{\&quot;REGISTRA\&quot;}:::r\n    CANDIDATO ---|\&quot;0..1\&quot;| R_CONSENTE\n    R_CONSENTE ---|\&quot;1..1 (Obrigatório)\&quot;| CONSENTIMENTO\n\n    R_INCLUI{\&quot;SE TORNA\&quot;}:::r\n    CANDIDATO ---|\&quot;0..1\&quot;| R_INCLUI\n    R_INCLUI ---|\&quot;1..1 (Obrigatório)\&quot;| PARTICIPANTE\n\n    R_AGENDA{\&quot;AGENDA\&quot;}:::r\n    PARTICIPANTE ---|\&quot;0..N\&quot;| R_AGENDA\n    R_AGENDA ---|\&quot;1..1 (Obrigatório)\&quot;| VISITA\n\n    R_SEGUE{\&quot;SEGUE O MODELO\&quot;}:::r\n    VISITA_PREVISTA ---|\&quot;0..N\&quot;| R_SEGUE\n    R_SEGUE ---|\&quot;1..1 (Obrigatório)\&quot;| VISITA\n\n    R_RESULT{\&quot;REGISTRA RESULTADO\&quot;}:::r\n    VISITA ---|\&quot;0..N\&quot;| R_RESULT\n    R_RESULT ---|\&quot;0..N\&quot;| ATIVIDADE\n    R_RESULT --- rr1([\&quot;valor_fictício\&quot;]):::a\n    R_RESULT --- rr2([\&quot;data_registro\&quot;]):::a\n\n    R_FAZ{\&quot;FAZ\&quot;}:::r\n    PARTICIPANTE ---|\&quot;0..N\&quot;| R_FAZ\n    R_FAZ ---|\&quot;1..1 (Obrigatório)\&quot;| SOLICITACAO\n\n    R_REFERE{\&quot;REFERE-SE A\&quot;}:::r\n    SOLICITACAO ---|\&quot;0..1\&quot;| R_REFERE\n    R_REFERE ---|\&quot;0..N\&quot;| VISITA\n\n    R_DECIDE{\&quot;DECIDE\&quot;}:::r\n    COORDENADOR ---|\&quot;0..N\&quot;| R_DECIDE\n    PESQUISADOR ---|\&quot;0..N\&quot;| R_DECIDE\n    R_DECIDE ---|\&quot;0..1\&quot;| SOLICITACAO\n\n    R_GERA{\&quot;GERA LOG\&quot;}:::r\n    USUARIO ---|\&quot;0..N\&quot;| R_GERA\n    R_GERA ---|\&quot;1..1 (Obrigatório)\&quot;| AUDITORIA&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-fkLGNQey0R8-otKWV17-538">
