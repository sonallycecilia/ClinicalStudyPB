        <mxCell id="entidade-12-operacoes" vertex="1" parent="entidade-12" value="&lt;div style=&quot;font-family:Recursive,Arial,sans-serif;font-size:13px;line-height:24px;border-top:1px solid #D1D5DB;padding-top:10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:bold;color:#2563EB;line-height:17px;margin-bottom:8px;&quot;&gt;PREVISTO &amp;#183; DESCRI&amp;#199;&amp;#195;O DO ADMINISTRADOR&lt;/div&gt;&lt;div&gt;+ registrarAcao()&lt;/div&gt;&lt;div&gt;+ consultarRegistros()&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=12;strokeColor=none;fillColor=none;fontFamily=Recursive;fontSize=13;fontColor=#111827;">
          <mxGeometry as="geometry" x="0" y="244" width="400" height="125" />
        </mxCell>
        <mxCell id="notas-titulo" value="REGRAS E PENDÊNCIAS — referência para as caixas acima" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=none;strokeColor=none;fontStyle=1;fontSize=18;">
          <mxGeometry x="48" y="1451" width="1696" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-2" value="CRITÉRIO DE ELEGIBILIDADE&#xD;&#xA;&#xD;&#xA;Pesquisador define critérios de inclusão e exclusão por estudo. Definir critérios é diferente de avaliar um candidato." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="1507" width="832" height="134" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-3" value="VISITA PREVISTA&#xD;&#xA;&#xD;&#xA;Planejamento de visitas do estudo; não representa uma visita individual. Quem pode alterar o planejamento ainda precisa ser confirmado." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="1507" width="832" height="134" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-4" value="ATIVIDADE DE VISITA&#xD;&#xA;&#xD;&#xA;Atividade planejada não é resultado de avaliação. Participante não altera o protocolo. Permissões de RF06 ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="1665" width="832" height="134" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-5" value="CANDIDATO&#xD;&#xA;&#xD;&#xA;Cadastro por Pesquisador ou Coordenador, sem autocadastro. Candidato vinculado a um estudo, conta de acesso e participação são conceitos distintos. Vínculo Usuário–Candidato e momento da criação da conta ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="1665" width="832" height="156" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-6" value="AVALIAÇÃO DE ELEGIBILIDADE&#xD;&#xA;&#xD;&#xA;Coordenador verifica elegibilidade; candidato não aprova a própria elegibilidade. Valores dos resultados, reavaliações e edição por outros perfis ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="1845" width="832" height="134" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-7" value="CONSENTIMENTO&#xD;&#xA;&#xD;&#xA;Consentimento simulado registrado é condição para inclusão (RF11). O registro ocorre na web; quem pode registrar ou retificar ainda precisa ser definido." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="1845" width="832" height="134" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-10" value="RESULTADO DE AVALIAÇÃO&#xD;&#xA;&#xD;&#xA;Resultados fictícios de avaliações previstas. Sem diagnóstico ou decisão clínica automatizada. RF14 prevê registro pela web; informação solicitada no mobile não autoriza editar qualquer resultado. Tipo de valor_ficticio e executor de RF14 ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="2003" width="832" height="156" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-11" value="SOLICITAÇÃO DE VISITA&#xD;&#xA;&#xD;&#xA;Participante solicita alterações das próprias visitas. Solicitar reagendamento não muda automaticamente a data. Uso desta entidade para confirmação é proposta. Processamento e estados pendentes. Retirada não foi adicionada a esta entidade." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="2003" width="832" height="156" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-12" value="AUDITORIA&#xD;&#xA;&#xD;&#xA;Captura de eventos pelo sistema é proposta técnica; Administrador consulta auditoria. Consulta não implica editar ou apagar histórico. Eventos, retenção e permissões detalhadas ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="2183" width="832" height="156" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>