        <mxCell id="entidade-9-atributos" parent="entidade-9" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=16;spacingTop=4;spacingRight=16;spacingBottom=8;strokeColor=none;fillColor=none;fontColor=#111827;fontSize=13;connectable=0;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;table-layout:fixed;font-family:Recursive,Arial,sans-serif;font-size:13px;color:#111827;&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:62%;&quot;&gt;&lt;col style=&quot;width:38%;&quot;&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style=&quot;height:30px;text-align:left;color:#6B7280;font-size:11px;font-weight:600;border-bottom:1px solid #D1D5DB;&quot;&gt;ATRIBUTO&lt;/th&gt;&lt;th style=&quot;height:30px;text-align:right;color:#6B7280;font-size:11px;font-weight:600;border-bottom:1px solid #D1D5DB;&quot;&gt;TIPO&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;id_visita&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;id_participacao*&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;id_visita_prevista*&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;data_agendada&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;status&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;VARCHAR(30)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;data_realizacao&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="226" width="400" y="48" as="geometry" />
        </mxCell>
        <mxCell id="entidade-9-operacoes" vertex="1" parent="entidade-9" value="&lt;div style=&quot;font-family:Recursive,Arial,sans-serif;font-size:13px;line-height:24px;border-top:1px solid #D1D5DB;padding-top:10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:bold;color:#2563EB;line-height:17px;margin-bottom:8px;&quot;&gt;PREVISTO &amp;#183; RF12–13, RF15, RF18&lt;/div&gt;&lt;div&gt;+ agendarVisita()&lt;/div&gt;&lt;div&gt;+ registrarRealizacao()&lt;/div&gt;&lt;div&gt;+ registrarAusencia()&lt;/div&gt;&lt;div&gt;+ registrarCancelamento()&lt;/div&gt;&lt;div&gt;+ consultarHistorico()&lt;/div&gt;&lt;div&gt;+ consultarProximasVisitas()&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=12;strokeColor=none;fillColor=none;fontFamily=Recursive;fontSize=13;fontColor=#111827;">
          <mxGeometry as="geometry" x="0" y="274" width="400" height="221" />
        </mxCell>
        <mxCell id="notas-titulo" value="REGRAS E PENDÊNCIAS — referência para as caixas acima" parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=none;strokeColor=none;fontStyle=1;fontSize=18;">
          <mxGeometry x="48" y="1883" width="1696" height="40" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-0" value="USUÁRIO&#xD;&#xA;&#xD;&#xA;Herança de dados não concede permissões administrativas. Conta inativa não autentica. Participante não tem autocadastro. Encerrar sessão na interface não significa revogar o token no servidor." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="1939" width="832" height="156" as="geometry" />
        </mxCell>
        <mxCell id="nota-perfil-admin" value="ADMINISTRADOR&#xD;&#xA;&#xD;&#xA;Atributos herdados de Usuário. Não pode excluir/inativar a própria conta nem remover o próprio perfil de Administrador. A API /users hoje é exclusiva do Administrador. A nova criação de acesso de Participante por Pesquisador/Coordenador deve ser limitada a esse perfil." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="1939" width="832" height="178" as="geometry" />
        </mxCell>
        <mxCell id="nota-perfil-pesquisador" value="PESQUISADOR&#xD;&#xA;&#xD;&#xA;Atributos herdados de Usuário. Estudos ainda no navegador. Cadastro de candidato e criação de acesso de Participante: regra da equipe, a implementar; momento de criação da conta pendente. Não autoriza criar Administradores ou promover perfis. Protocolo versus Estudo precisa ser detalhado." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="2141" width="832" height="178" as="geometry" />
        </mxCell>
        <mxCell id="nota-perfil-coordenador" value="COORDENADOR&#xD;&#xA;&#xD;&#xA;Atributos herdados de Usuário. Sem área própria implementada na web. Cadastro de candidato e acesso de Participante pela equipe; não permite criar Administradores ou promover perfis. Momento da conta e permissões detalhadas pendentes." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="2141" width="832" height="156" as="geometry" />
        </mxCell>
        <mxCell id="nota-perfil-participante" value="PARTICIPANTE&#xD;&#xA;&#xD;&#xA;Atributos herdados de Usuário. SEM AUTOCADASTRO: conta criada por Pesquisador/Coordenador. Acesso somente aos próprios dados autorizados. Não cadastra candidatos, não se inclui no estudo e não administra contas. Solicitar reagendamento ou retirada não efetiva a alteração." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="2343" width="832" height="178" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-1" value="ESTUDO&#xD;&#xA;&#xD;&#xA;Estados previstos: planejamento, recrutamento, execução e encerrado. O protótipo usa Planejado e Em andamento. Indicadores agregam candidatos, participantes e visitas. Transições e permissões detalhadas ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="2343" width="832" height="156" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-8" value="PARTICIPAÇÃO NO ESTUDO&#xD;&#xA;&#xD;&#xA;Incluir somente candidato elegível, com consentimento e vaga disponível. Inclusão é ação autorizada da equipe. Solicitar retirada (RF20) é diferente de registrar retirada (RF16). Quem efetiva inclusão e retirada e como guardar a solicitação ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="48" y="2545" width="832" height="178" as="geometry" />
        </mxCell>
        <mxCell id="nota-entidade-9" value="VISITA&#xD;&#xA;&#xD;&#xA;Agendamento para participantes incluídos. Coordenador organiza visitas; Participante consulta somente as suas. Confirmar presença prevista não registra comparecimento realizado. Permissões detalhadas de registro ainda a definir." parent="1" vertex="1" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#111827;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;fillColor=#F3F4F6;strokeColor=#D1D5DB;spacing=16;">
          <mxGeometry x="912" y="2545" width="832" height="156" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
