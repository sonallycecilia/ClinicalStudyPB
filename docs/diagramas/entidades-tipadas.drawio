        <mxCell id="entidade-2-operacoes" vertex="1" parent="entidade-2" value="&lt;div style=&quot;font-family:Recursive,Arial,sans-serif;font-size:13px;line-height:24px;border-top:1px solid #D1D5DB;padding-top:10px;&quot;&gt;&lt;div style=&quot;font-size:11px;font-weight:bold;color:#2563EB;line-height:17px;margin-bottom:8px;&quot;&gt;PREVISTO &amp;#183; RF05&lt;/div&gt;&lt;div&gt;+ definirCriterio()&lt;/div&gt;&lt;div&gt;+ consultarCriteriosEstudo()&lt;/div&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=8;spacingBottom=12;strokeColor=none;fillColor=none;fontFamily=Recursive;fontSize=13;fontColor=#111827;">
