        <mxCell id="entidade-12-atributos" parent="entidade-12" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;spacingLeft=16;spacingTop=4;spacingRight=16;spacingBottom=8;strokeColor=none;fillColor=none;fontColor=#111827;fontSize=13;connectable=0;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" value="&lt;table style=&quot;width:100%;border-collapse:collapse;table-layout:fixed;font-family:Recursive,Arial,sans-serif;font-size:13px;color:#111827;&quot;&gt;&lt;colgroup&gt;&lt;col style=&quot;width:62%;&quot;&gt;&lt;col style=&quot;width:38%;&quot;&gt;&lt;/colgroup&gt;&lt;tr&gt;&lt;th style=&quot;height:30px;text-align:left;color:#6B7280;font-size:11px;font-weight:600;border-bottom:1px solid #D1D5DB;&quot;&gt;ATRIBUTO&lt;/th&gt;&lt;th style=&quot;height:30px;text-align:right;color:#6B7280;font-size:11px;font-weight:600;border-bottom:1px solid #D1D5DB;&quot;&gt;TIPO&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;id_auditoria&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;id_usuario*&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;acao&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;VARCHAR(50)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;data_hora&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;TIMESTAMPTZ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;height:30px;padding:0 4px 0 0;white-space:nowrap;border-bottom:1px solid #E5E7EB;&quot;&gt;entidade&lt;/td&gt;&lt;td style=&quot;height:30px;text-align:right;white-space:nowrap;color:#4B5563;border-bottom:1px solid #E5E7EB;&quot;&gt;VARCHAR(100)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
