        <mxCell id="entidade-9" parent="1" style="swimlane;html=0;horizontal=1;startSize=48;rounded=0;collapsible=0;container=1;whiteSpace=wrap;fillColor=#DCEAFE;swimlaneFillColor=#F3F4F6;strokeColor=#2563EB;strokeWidth=2;fontColor=#111827;fontSize=15;fontStyle=1;align=center;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;fontFamily=Recursive;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" value="VISITA" vertex="1">
