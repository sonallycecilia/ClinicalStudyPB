        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n    %% ENTIDADES\n    U[\&quot;USUÁRIO\&quot;]\n    E[\&quot;ESTUDO\&quot;]\n    CE[\&quot;CRITÉRIO DE ELEGIBILIDADE\&quot;]\n    VP[\&quot;VISITA PREVISTA\&quot;]\n    AV[\&quot;ATIVIDADE DE VISITA\&quot;]\n    C[\&quot;CANDIDATO\&quot;]\n    AE[\&quot;AVALIAÇÃO DE ELEGIBILIDADE\&quot;]\n    CO[\&quot;CONSENTIMENTO\&quot;]\n    P[\&quot;PARTICIPAÇÃO NO ESTUDO\&quot;]\n    V[\&quot;VISITA\&quot;]\n    RA[\&quot;RESULTADO DE AVALIAÇÃO\&quot;]\n    SV[\&quot;SOLICITAÇÃO DE VISITA\&quot;]\n    AU[\&quot;AUDITORIA\&quot;]\n\n    %% RELACIONAMENTOS\n    R1{\&quot;RESPONSÁVEL POR\&quot;}\n    R2{\&quot;DEFINE\&quot;}\n    R3{\&quot;PLANEJA\&quot;}\n    R4{\&quot;CONTÉM\&quot;}\n    R5{\&quot;RECEBE\&quot;}\n    R6{\&quot;AVALIA\&quot;}\n    R7{\&quot;REGISTRA\&quot;}\n    R8{\&quot;FORMALIZA\&quot;}\n    R9{\&quot;POSSUI\&quot;}\n    R10{\&quot;ORIENTA\&quot;}\n    R11{\&quot;PRODUZ\&quot;}\n    R12{\&quot;SOLICITA\&quot;}\n    R13{\&quot;GERA\&quot;}\n\n    %% ATRIBUTOS\n    U_ID([\&quot;id_usuario PK\&quot;])\n    U_NOME([\&quot;nome\&quot;])\n    U_EMAIL([\&quot;email\&quot;])\n    U_PERFIL([\&quot;perfil\&quot;])\n    U_SENHA([\&quot;senha_hash\&quot;])\n\n    E_ID([\&quot;id_estudo PK\&quot;])\n    E_TITULO([\&quot;titulo\&quot;])\n    E_OBJ([\&quot;objetivo\&quot;])\n    E_INICIO([\&quot;data_inicio\&quot;])\n    E_FIM([\&quot;data_fim\&quot;])\n    E_LIMITE([\&quot;limite_participantes\&quot;])\n    E_STATUS([\&quot;status\&quot;])\n\n    CE_ID([\&quot;id_criterio PK\&quot;])\n    CE_TIPO([\&quot;tipo: inclusão/exclusão\&quot;])\n    CE_DESC([\&quot;descricao\&quot;])\n\n    VP_ID([\&quot;id_visita_prevista PK\&quot;])\n    VP_NOME([\&quot;nome\&quot;])\n    VP_ORDEM([\&quot;ordem\&quot;])\n\n    C_ID([\&quot;id_candidato PK\&quot;])\n    C_NOME([\&quot;nome\&quot;])\n    C_EMAIL([\&quot;email\&quot;])\n    C_STATUS([\&quot;status_recrutamento\&quot;])\n\n    CO_ID([\&quot;id_